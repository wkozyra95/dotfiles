assign [app_id="firefox"] workspace 1

# Identify monitors by "make model serial" instead of the DP-N connector name.
# Connector numbers are assigned dynamically and reshuffle on monitor
# reconnect / daisy-chain / Thunderbolt re-enumeration (e.g. DP-3 becomes DP-5),
# which breaks any connector-based layout. The make/model/serial identifier is
# stable across all of those. Both monitors are Dell U2725QE, so the serial is
# what distinguishes them:
#   primary   = landscape monitor (serial 6SZSC34)
#   secondary = portrait  monitor (serial 8TZSC34)

output "Dell Inc. DELL U2725QE 6SZSC34" pos 0 400 scale 1.5
output "Dell Inc. DELL U2725QE 8TZSC34" pos 2560 0 transform 270 scale 1.5

workspace 1  output "Dell Inc. DELL U2725QE 6SZSC34"
workspace 2  output "Dell Inc. DELL U2725QE 6SZSC34"
workspace 3  output "Dell Inc. DELL U2725QE 6SZSC34"
workspace 4  output "Dell Inc. DELL U2725QE 6SZSC34"
workspace 5  output "Dell Inc. DELL U2725QE 6SZSC34"
workspace 6  output "Dell Inc. DELL U2725QE 8TZSC34"
workspace 7  output "Dell Inc. DELL U2725QE 8TZSC34"
workspace 8  output "Dell Inc. DELL U2725QE 6SZSC34"
workspace 9  output "Dell Inc. DELL U2725QE 6SZSC34"
workspace 10 output "Dell Inc. DELL U2725QE 6SZSC34"
